# ParkVision backend configuration (PV_ prefix maps onto app.core.config.Settings)
# Copy to .env for local overrides; docker-compose already sets sane dev values.

PV_ENV=dev
PV_DATABASE_DSN=postgresql+asyncpg://app_user:app_password@localhost:5432/vehicle_mgmt
PV_MIGRATION_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/vehicle_mgmt
PV_REDIS_DSN=redis://localhost:6379/0

# REQUIRED in production — rotate via PV_JWT_PREVIOUS_SECRETS
PV_JWT_SECRET=dev-local-secret-change-me
PV_JWT_PREVIOUS_SECRETS=

PV_COOKIE_SECURE=false
PV_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

PV_MQTT_HOST=localhost
PV_MQTT_PORT=1883

PV_S3_ENDPOINT=localhost:9000
PV_S3_ACCESS_KEY=minioadmin
PV_S3_SECRET_KEY=minioadmin
PV_S3_BUCKET=anpr-images

PV_SMTP_HOST=localhost
PV_SMTP_PORT=1025
PV_SMTP_FROM=no-reply@parkvision.dev

PV_BOOTSTRAP_ADMIN_EMAIL=admin@parkvision.dev
PV_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!234
