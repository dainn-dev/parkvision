# --- Core ---
APP_ENV=local
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://parkvision:parkvision@localhost:5432/parkvision
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Redis (pub/sub + arq queue) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (HS256 keyring; first key signs, all verify -> rotate by prepending) ---
# JSON list of {"kid": "...", "key": "base64-or-plain-secret"} entries
JWT_KEYS=[{"kid":"local-1","key":"dev-only-change-me-please-use-a-long-random-secret"}]
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_TOKEN_TTL_SECONDS=300

# --- Cookies / CSRF ---
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# --- MFA secret encryption (Fernet key: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`) ---
MFA_SECRET_KEY=change-me-fernet-key

# --- MQTT (EMQX 5) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
GATE_COMMAND_TIMEOUT_SECONDS=15
EDGE_OFFLINE_AFTER_SECONDS=90

# --- S3 / MinIO (ANPR snapshots) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=parkvision-snapshots
S3_PRESIGN_TTL_SECONDS=900

# --- SMTP (Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@parkvision.local
SMTP_TLS=false

# --- Worker ---
PARTITION_LOOKAHEAD_PERIODS=2

# --- Bootstrap (first-run seeding; ignored after) ---
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@parkvision.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-me-admin-password
