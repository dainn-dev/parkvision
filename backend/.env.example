# --- Core ---
APP_NAME=vehicle-management
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=false

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://vehicle_app:vehicle_app@postgres:5432/vehicle_mgmt
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vehicle_mgmt
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (pub/sub fan-out + arq queue) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Rotate by appending old secrets to JWT_PREVIOUS_SECRETS
JWT_SECRET=change-me-32-byte-minimum-secret
JWT_PREVIOUS_SECRETS=[]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Cookies / CSRF ---
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=vm_csrf
ACCESS_COOKIE_NAME=vm_access
REFRESH_COOKIE_NAME=vm_refresh

# --- Encryption (Fernet key for TOTP secrets at rest) ---
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# --- MQTT (EMQX) ---
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backend-secret
MQTT_TLS=false
MQTT_COMMAND_TIMEOUT_SECONDS=15

# --- S3-compatible object storage (MinIO) ---
S3_ENDPOINT_URL=http://s3:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=vehicle-events
S3_PRESIGN_TTL_SECONDS=900

# --- SMTP (Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@parkvision.example.com
SMTP_TLS=false
APP_BASE_URL=http://localhost:3000

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Seed ---
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!123
