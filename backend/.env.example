# --- App ---
ENVIRONMENT=development
API_PREFIX=/api/v1

# --- Database ---
# Application role (subject to RLS). Migrations use ALEMBIC_DATABASE_URL (superuser).
DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/parkvision
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parkvision

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MQTT (EMQX) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=parkvision-media
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM=noreply@parkvision.dev
APP_BASE_URL=http://localhost:8000

# --- Auth / security ---
JWT_SECRET=dev-only-change-me-in-prod-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_TICKET_TTL_SECONDS=300
# Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_KEY=NvTgnQnyFlkaCbyGBl1CZzU6aoFuXKZod8fxDL-3JYc=
COOKIE_SECURE=false
COOKIE_DOMAIN=
CSRF_ENABLED=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Limits ---
LOGIN_RATE_LIMIT_PER_MINUTE=10
GATE_COMMAND_ACK_TIMEOUT_SECONDS=30
EDGE_DEVICE_OFFLINE_SECONDS=120
IMAGE_RETENTION_DAYS=180
