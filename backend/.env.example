# --- Core ---
APP_NAME=vehicle-management
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=false

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql+asyncpg://vehicle_app:vehicle_app@postgres:5432/vehicle_mgmt
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vehicle_mgmt
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (pub/sub fan-out + arq queue) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Rotate by appending old secrets to JWT_PREVIOUS_SECRETS
JWT_SECRET=change-me-32-byte-minimum-secret
JWT_PREVIOUS_SECRETS=[]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Cookies / CSRF ---
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=vm_csrf
ACCESS_COOKIE_NAME=vm_access
REFRESH_COOKIE_NAME=vm_refresh

# --- Encryption (Fernet key for TOTP secrets at rest) ---
FIELD_ENCRYPTION_KEY=change-me-fernet-key

# --- MQTT (EMQX) ---
MQTT_HOST=emqx
# Host edge devices should connect to (LAN/public). Blank falls back to
# MQTT_HOST, which is only resolvable inside the Compose network.
MQTT_PUBLIC_HOST=
# How devices reach the broker when that differs from the bridge's internal
# connection. Behind an HTTP-only proxy (Cloudflare) use MQTT over WebSocket
# through the dashboard host's /mqtt route:
#   MQTT_PUBLIC_HOST=parkvision.example.com
#   MQTT_PUBLIC_TRANSPORT=websocket
#   MQTT_PUBLIC_PORT=443
#   MQTT_PUBLIC_TLS=true
#   MQTT_PUBLIC_WS_PATH=/mqtt
# Blank MQTT_PUBLIC_PORT / MQTT_PUBLIC_TLS fall back to MQTT_PORT / MQTT_TLS.
MQTT_PUBLIC_TRANSPORT=tcp
MQTT_PUBLIC_PORT=
MQTT_PUBLIC_TLS=
MQTT_PUBLIC_WS_PATH=/mqtt
MQTT_PORT=1883
# The bridge's own login. EMQX checks it through /edge/mqtt-auth like any
# device. The default password below only works on the plain dev stack; once
# MQTT_HOOK_SECRET is set or ENVIRONMENT is not development, set a unique one.
MQTT_USERNAME=backend
MQTT_PASSWORD=backend-secret
# Shared secret EMQX sends to /edge/mqtt-auth (same value for the API and the
# emqx container). Required whenever the API is reachable from the Internet:
# outside ENVIRONMENT=development an unset secret makes the hook deny everyone.
MQTT_HOOK_SECRET=
MQTT_TLS=false
MQTT_COMMAND_TIMEOUT_SECONDS=15

# --- S3-compatible object storage (MinIO) ---
# Inside the Compose network LocalStack listens on 4566 (host publishes 9000).
# Presigned URLs are opened by browsers, so sign them against the published host port.
S3_ENDPOINT_URL=http://s3:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=vehicle-events
S3_PRESIGN_TTL_SECONDS=900

# --- SMTP (Mailpit in dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@parkvision.example.com
SMTP_TLS=false
APP_BASE_URL=http://localhost:3000

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Browser origins allowed to PUT/GET presigned S3 URLs. The signature is the
# capability, so "*" does not widen access.
S3_CORS_ORIGINS=["*"]

# --- Seed ---
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe!123
