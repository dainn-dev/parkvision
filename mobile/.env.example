# Base path prepended to every API request by src/lib/api.ts.
# Keep "/api/v1" and use the dev-server proxy below, or set a full URL
# (e.g. http://localhost:8000/api/v1) to bypass the proxy.
VITE_API_BASE_URL=/api/v1

# Dev-server proxy target for /api/* (vite.config.ts server.proxy).
# Point at a running backend API.
VITE_API_PROXY=http://localhost:8000
