# Access log without the query string: ?plate=, ?ticket= and legacy ?token=
# carry plates / credentials and must not land in logs. $uri excludes args.
log_format noquery '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log noquery;
    # Security headers. CSP allows same-origin and the API/WS upstream,
    # but no inline scripts — tightening XSS so localStorage tokens (if any
    # legacy client still uses them) are harder to exfiltrate.
    # - the one inline script (theme bootstrap in index.html) is allowed by its hash only;
    #   src/lib/__tests__/csp.test.ts fails if the script and the hash drift apart
    # - 'wasm-unsafe-eval' lets the 3D tour compile its WebAssembly mesh decoder (meshopt);
    #   it does not allow JavaScript eval
    # - blob: is how GLTFLoader hands textures embedded in .glb files to the browser
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-oAZ+lm4+H77dOSIILpCpC51MxBK3u8yR1O75VDgblyc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com ${S3_PUBLIC_ORIGIN}; connect-src 'self' blob: ws: wss: ${S3_PUBLIC_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /usr/share/nginx/html;
    index index.html;

    # REST API -> backend (same contract as the Vite dev proxy).
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (gate telemetry fan-out).
    location /ws {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
    }

    # MQTT over WebSocket for edge devices that can only reach this host over
    # HTTPS (e.g. behind Cloudflare). EMQX still authenticates every client
    # through the API's /edge/mqtt-auth hook.
    location = /mqtt {
        proxy_pass ${MQTT_WS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA fallback — React Router owns every non-asset path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
