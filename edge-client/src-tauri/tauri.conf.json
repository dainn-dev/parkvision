{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParkVision Edge",
  "version": "0.1.3",
  "identifier": "com.parkvision.edge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ParkVision Edge",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFOUE0NDQ3RUNFMjg0QzcKUldUSGhPTHNSMFNhWHZndDhiMkgvbE52ZkVXc3duM3NVYXNHMkZGMEFVd2dIYTdQTHBEQVZMTUgK",
      "endpoints": [
        "https://api-parkvision.dainn.online/api/v1/updates/edge/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
